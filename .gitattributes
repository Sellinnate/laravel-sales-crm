# Normalize line endings to LF for text files (consistent Pint/PHPStan across OSes).
* text=auto eol=lf

# Binary files: never touch them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.xlsx binary
*.zip binary

# Path-based git attributes: excluded from the Composer dist archive.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/art                export-ignore
/docs               export-ignore
/tests              export-ignore
/workbench          export-ignore
/CLAUDE.md          export-ignore
/CONTRIBUTING.md    export-ignore
/docmd.config.json  export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpstan.neon.dist  export-ignore
/phpunit.xml.dist   export-ignore
/testbench.yaml     export-ignore
/wrangler.jsonc     export-ignore

# The compiled CSS of the UI is generated by `npm run css:build`.
/resources/dist/** linguist-generated
